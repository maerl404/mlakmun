# Main menu

def main():
    # Keep showing the menu until the user picks 5
    while True:
        print("\n===== HABIT & TASK TRACKER =====")
        print("1. Add a Task or Habit")
        print("2. Mark a Task or Habit as complete")
        print("3. Remove a Task or Habit")
        print("4. View reports")
        print("5. Exit")

        # input() gives back text, so compare to '1', '2', etc.
        choice = input("Choose an option (1-5): ").strip()

        if choice == '1':
            sub = input("Add a (T)ask or a (H)abit? ").strip().lower()
            if sub in ('t', 'task'):
                add_task()
            elif sub in ('h', 'habit'):
                add_habit()
            else:
                print("Invalid choice. Please enter T or H.")

        elif choice == '2':
            sub = input("Mark a (T)ask or a (H)abit as complete? ").strip().lower()
            if sub in ('t', 'task'):
                mark_task_complete()
            elif sub in ('h', 'habit'):
                mark_habit_complete()
            else:
                print("Invalid choice. Please enter T or H.")

        elif choice == '3':
            sub = input("Remove a (T)ask or a (H)abit? ").strip().lower()
            if sub in ('t', 'task'):
                remove_task()
            elif sub in ('h', 'habit'):
                remove_habit()
            else:
                print("Invalid choice. Please enter T or H.")

        elif choice == '4':
            sub = input("Do you want a (W)eekly or (D)aily report? ").strip().lower()
            if sub in ('w', 'weekly'):
                weekly_report()
            elif sub in ('d', 'daily'):
                daily_report()
            else:
                print("Invalid choice. Please enter W or D.")

        elif choice == '5':
            print("Goodbye! Keep up the good work!")
            break

        else:
            print("Invalid option. Please enter a number from 1 to 5.")


main()
